HANDOVER_HOST=127.0.0.1
HANDOVER_PORT=8025
HANDOVER_PUBLIC_URL=
# Optional comma-separated public aliases, including a path such as /handover/.
HANDOVER_PUBLIC_ALIASES=
HANDOVER_DATA_DIR=/var/lib/handover-ui
# Generate independent random values outside Git; never use these literal placeholders.
# Retired values: preserve existing protected config for archival; not used for login.
HANDOVER_AGENT_TOKEN=
HANDOVER_LOGIN_CODE=
# Required protected administration configuration (not a username login credential).
HANDOVER_ADMIN_TOKEN=
HANDOVER_VAPID_PUBLIC_KEY=
HANDOVER_VAPID_PRIVATE_KEY=
HANDOVER_VAPID_SUBJECT=
# Configure the receiver in its own restricted EnvironmentFile.
HANDOVER_WEBHOOK_SECRET=
# Optional same-server notification bridge. Off until private receiver setup.
# Socket owner UID and comma-separated allowlists must be explicit.
# A standalone * allows all valid values in that list; never mix it with entries.
# All-visitor automatic delivery also requires the receiver's explicit policy.
# No WeChat/CNB credential or shared secret belongs in this project.
HANDOVER_NOTIFY_ENABLED=0
HANDOVER_NOTIFY_SOCKET=
HANDOVER_NOTIFY_SOCKET_UID=
HANDOVER_NOTIFY_SOURCES=
HANDOVER_NOTIFY_USERNAMES=
HANDOVER_NOTIFY_MAX_PENDING=128
HANDOVER_NOTIFY_PER_SOURCE_MINUTE=5
HANDOVER_NOTIFY_INTERVAL_MS=1000
HANDOVER_NOTIFY_TIMEOUT_MS=3000
