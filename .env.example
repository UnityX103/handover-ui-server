HANDOVER_HOST=127.0.0.1
HANDOVER_PORT=8025
HANDOVER_PUBLIC_URL=https://your-server.example:8024
HANDOVER_DATA_DIR=/var/lib/handover-ui
# Generate independent random values outside Git; never use these literal placeholders.
HANDOVER_AGENT_TOKEN=replace-with-random-agent-token
HANDOVER_ADMIN_TOKEN=replace-with-random-owner-token
HANDOVER_VAPID_SUBJECT=https://your-server.example:8024
